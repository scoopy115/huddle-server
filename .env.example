# Name shown in the dashboard and in the Huddle app
HUDDLE_SERVER_NAME=Huddle Server

# Public domain for Let's Encrypt (leave empty for a self-signed certificate)
HUDDLE_DOMAIN=
# Caddyfile.domain when HUDDLE_DOMAIN is set, Caddyfile.selfsigned otherwise
HUDDLE_CADDYFILE=Caddyfile.selfsigned

# Ports on this host
# HUDDLE_PORT: client API + MCP (the Huddle app connects here). HUDDLE_DASHBOARD_PORT: the dashboard.
# HUDDLE_HTTP_PORT: only used for the Let's Encrypt challenge.
HUDDLE_PORT=443
HUDDLE_DASHBOARD_PORT=8443
HUDDLE_HTTP_PORT=80

# Address clients use to reach this server, shown in the dashboard (empty = derived from the dashboard's own address)
HUDDLE_PUBLIC_URL=
# Largest recording a client may send, in MB
HUDDLE_MAX_UPLOAD_MB=2048

# Language the notes are written in when the dashboard leaves it on "automatic" (en, nl, de, …)
HUDDLE_LANGUAGE=en

# Image to run (a locally built one: huddle-server:local)
HUDDLE_IMAGE=ghcr.io/scoopy115/huddle-server:latest

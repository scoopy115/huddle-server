# Name shown in the dashboard and in the Huddle app
HUDDLE_SERVER_NAME=Huddle Server

# Port on this host (dashboard, client API and MCP, plain HTTP). Put a reverse proxy in front for TLS.
HUDDLE_PORT=48731

# Address clients use to reach this server, shown in the dashboard (empty = derived from the dashboard's own address)
HUDDLE_PUBLIC_URL=
# Largest recording a client may send, in MB
HUDDLE_MAX_UPLOAD_MB=2048
# Language the notes are written in when a client does not say (en, nl, de, …)
HUDDLE_LANGUAGE=en

# Image to run (a locally built one: huddle-server:local)
HUDDLE_IMAGE=ghcr.io/scoopy115/huddle-server:latest

# ---- Optional built-in TLS. Uncomment all three; set HUDDLE_DOMAIN for Let's Encrypt, leave it
# empty for the server's own certificate (confirmed by fingerprint in the Huddle app).
#COMPOSE_PROFILES=tls
#HUDDLE_TLS_DIR=/certs
#HUDDLE_DOMAIN=
#HUDDLE_CADDYFILE=Caddyfile.selfsigned
#HUDDLE_TLS_PORT=443
#HUDDLE_TLS_DASHBOARD_PORT=8443
#HUDDLE_HTTP_PORT=80
